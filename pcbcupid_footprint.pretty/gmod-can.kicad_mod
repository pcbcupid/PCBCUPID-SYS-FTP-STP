	(model "${KICAD9_PCBCUPID_3DMODEL_DIR}/gmod_can.wrl"
		(offset
			(xyz 0 0 0)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz 0 0 0)
		)
	)
)
